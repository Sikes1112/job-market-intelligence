# Render backend URL for deployed Vercel builds.
VITE_API_BASE_URL=https://<render-service>.onrender.com

# Leave VITE_API_BASE_URL unset for local development when using the Vite
# dev proxy in vite.config.ts.

# Auth0 SPA settings for account/personalization UX. Leave unset for local/demo
# public market exploration without sign-in.
# VITE_AUTH0_DOMAIN=<tenant>.us.auth0.com
# VITE_AUTH0_CLIENT_ID=<spa-client-id>
# VITE_AUTH0_AUDIENCE=https://api.job-market-intelligence.local

# Optional. Defaults to /markets on the current browser origin when unset.
# VITE_AUTH0_REDIRECT_URI=http://127.0.0.1:5173/markets
