# Backend environment: local | test | private_demo | public_demo | staging | production
# Legacy dev/prod are still accepted. local/test can use safe local defaults.
# private_demo/public_demo/staging/production require DATABASE_URL.
# staging/production/prod reject SQLite DATABASE_URL values.
APP_ENV=local

# Logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Service identifier emitted in structured logs
SERVICE_NAME=jmi-backend

# Safe deployment identifier surfaced in health/operator diagnostics.
# Prefer the platform commit SHA or release id. Do not put repository secrets here.
RELEASE_ID=

# Production database pool. Defaults are suitable for a small Render/Neon beta.
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_RECYCLE_SECONDS=300

# Database URL (SQLAlchemy DSN). Leave blank for local/test SQLite default.
DATABASE_URL=

# Neon/Postgres private demo example. The app also accepts postgres:// and
# postgresql:// URLs and normalizes them to the SQLAlchemy psycopg driver.
# DATABASE_URL=postgresql+psycopg://APP_USER:APP_PASSWORD@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Render Python runtime pin for the private demo service.
PYTHON_VERSION=3.11.11

# Comma-separated exact browser origins allowed to call the API.
# Leave empty for local Vite proxy/no browser CORS. Do not use wildcards.
# APP_ENV=public_demo requires the exact public frontend origin.
CORS_ALLOWED_ORIGINS=
# CORS_ALLOWED_ORIGINS=https://job-market-intelligence.vercel.app

# Basic API protection. Empty feature flags mean false in local/test/dev/private_demo
# and true in public_demo/staging/production/prod. public_demo/staging/production/prod
# reject explicit false values where required.
RATE_LIMIT_ENABLED=
SECURITY_HEADERS_ENABLED=
MAX_REQUEST_BODY_BYTES=
RATE_LIMIT_REQUESTS=
RATE_LIMIT_WINDOW_SECONDS=
RATE_LIMIT_ANONYMOUS_REQUESTS=
RATE_LIMIT_ANONYMOUS_WINDOW_SECONDS=
RATE_LIMIT_AUTHENTICATED_REQUESTS=
RATE_LIMIT_AUTHENTICATED_WINDOW_SECONDS=
RATE_LIMIT_EXPENSIVE_REQUESTS=
RATE_LIMIT_EXPENSIVE_WINDOW_SECONDS=
RATE_LIMIT_MUTATION_REQUESTS=
RATE_LIMIT_MUTATION_WINDOW_SECONDS=
READINESS_REQUIRE_MIGRATION_CURRENT=
JOB_STALE_AFTER_SECONDS=
ERROR_MONITORING_DSN=
API_DOCS_ENABLED=
BETA_ACCESS_REQUIRED=
# local/test/private_demo defaults when unset:
# MAX_REQUEST_BODY_BYTES=1048576
# RATE_LIMIT_REQUESTS=120
# RATE_LIMIT_WINDOW_SECONDS=60
# RATE_LIMIT_EXPENSIVE_REQUESTS=20
# RATE_LIMIT_MUTATION_REQUESTS=60
# READINESS_REQUIRE_MIGRATION_CURRENT=false
# JOB_STALE_AFTER_SECONDS=3600
# public_demo defaults when unset:
# MAX_REQUEST_BODY_BYTES=65536
# RATE_LIMIT_REQUESTS=60
# RATE_LIMIT_WINDOW_SECONDS=60
# RATE_LIMIT_EXPENSIVE_REQUESTS=20
# RATE_LIMIT_MUTATION_REQUESTS=60
# staging/production/prod default READINESS_REQUIRE_MIGRATION_CURRENT=true

# Auth0 API token verification for protected /me routes.
# Required outside local/test if protected user routes are used.
# AUTH0_ISSUER should match the Auth0 tenant issuer exactly, including trailing slash.
AUTH0_ISSUER=
# Example: AUTH0_ISSUER=https://example.us.auth0.com/
AUTH0_AUDIENCE=
# Example: AUTH0_AUDIENCE=https://api.job-market-intelligence.example
# Optional; defaults to ${AUTH0_ISSUER}.well-known/jwks.json when AUTH0_ISSUER is set.
AUTH0_JWKS_URL=
AUTH0_JWKS_CACHE_SECONDS=300

# Stripe billing adapter. Leave blank to disable checkout, portal, and webhook
# handling. These secrets must never be exposed to the frontend.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=
STRIPE_BILLING_PORTAL_RETURN_URL=
# Stripe price IDs are external references mapped to internal plan keys. Free
# never has a Stripe price. Institutional plans can remain sales-assisted.
STRIPE_PRICE_INDIVIDUAL_MONTHLY=
STRIPE_PRICE_INDIVIDUAL_ANNUAL=
STRIPE_PRICE_STUDENT_ANNUAL=
STRIPE_PRICE_CAREER_CENTER_LICENSE=
STRIPE_PRICE_BOOTCAMP_LICENSE=
STRIPE_PRICE_UNIVERSITY_LICENSE=
STRIPE_PRICE_WORKFORCE_BOARD_LICENSE=

# Frontend Auth0 SPA settings. Leave unset for local/demo public exploration
# without account sign-in.
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=
VITE_AUTH0_REDIRECT_URI=
VITE_DEPLOYMENT_MODE=local
VITE_RELEASE_ID=

# Local/demo scripts refuse non-SQLite database targets unless this is set
# explicitly. Do not set this for production app runtime.
# JMI_ALLOW_NON_LOCAL_DEMO_DB=false
